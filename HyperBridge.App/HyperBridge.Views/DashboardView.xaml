<UserControl x:Class="HyperBridge.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="HyperBridge VM Migrator" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="Geführte Migration von VirtualBox nach Hyper-V mit Vorprüfung, Logging und Reporting." Style="{StaticResource PageSubtitleText}" />

            <UniformGrid Rows="2" Columns="3" Margin="0,20,0,0">
                <Button Content="Neue Migration starten" Style="{StaticResource PrimaryActionButton}" Command="{Binding StartNewMigrationCommand}" />
                <Button Content="Vorprüfung / Dry Run" Style="{StaticResource PrimaryActionButton}" Command="{Binding StartDryRunCommand}" />
                <Button Content="Logs / Berichte" Style="{StaticResource SecondaryActionButton}" Command="{Binding NavigateCommand}" CommandParameter="Logs" />
                <Button Content="Einstellungen" Style="{StaticResource SecondaryActionButton}" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
                <Button Content="Info" Style="{StaticResource SecondaryActionButton}" Command="{Binding NavigateCommand}" CommandParameter="Info" />
                <Button Content="Status aktualisieren" Style="{StaticResource SecondaryActionButton}" Command="{Binding RefreshStatusCommand}" />
            </UniformGrid>

            <Border Style="{StaticResource PanelCard}" Margin="0,24,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Systemstatus" Style="{StaticResource CardTitleText}" />
                        <TextBlock Text="Administrative Rechte" Style="{StaticResource FieldLabelText}" />
                        <TextBlock Text="{Binding IsAdmin, StringFormat=Admin: {0}}" Style="{StaticResource FieldValueText}" />

                        <TextBlock Text="VirtualBox erkannt" Style="{StaticResource FieldLabelText}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding IsVirtualBoxDetected, StringFormat=VirtualBox: {0}}" Style="{StaticResource FieldValueText}" />

                        <TextBlock Text="VBoxManage gefunden" Style="{StaticResource FieldLabelText}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding IsVBoxManageDetected, StringFormat=VBoxManage: {0}}" Style="{StaticResource FieldValueText}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Hyper-V Status" Style="{StaticResource CardTitleText}" />
                        <TextBlock Text="Hyper-V verfügbar" Style="{StaticResource FieldLabelText}" />
                        <TextBlock Text="{Binding IsHyperVDetected, StringFormat=Hyper-V: {0}}" Style="{StaticResource FieldValueText}" />

                        <TextBlock Text="PowerShell Cmdlets" Style="{StaticResource FieldLabelText}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding IsHyperVPowerShellDetected, StringFormat=Cmdlets: {0}}" Style="{StaticResource FieldValueText}" />

                        <TextBlock Text="Aktueller Schritt" Style="{StaticResource FieldLabelText}" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding CurrentStepText}" Style="{StaticResource FieldValueText}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>


