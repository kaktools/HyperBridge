<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ColorBackground">#0B111B</Color>
    <Color x:Key="ColorSurface">#121C2D</Color>
    <Color x:Key="ColorSurfaceAlt">#1A2840</Color>
    <Color x:Key="ColorTextPrimary">#E9F2FF</Color>
    <Color x:Key="ColorTextSecondary">#B5C7DE</Color>
    <Color x:Key="ColorAccent">#3CCBFF</Color>
    <Color x:Key="ColorAccentSecondary">#6C85FF</Color>
    <Color x:Key="ColorDanger">#D95A7A</Color>

    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushSurface" Color="{StaticResource ColorSurface}" />
    <SolidColorBrush x:Key="BrushSurfaceAlt" Color="{StaticResource ColorSurfaceAlt}" />
    <SolidColorBrush x:Key="BrushTextPrimary" Color="{StaticResource ColorTextPrimary}" />
    <SolidColorBrush x:Key="BrushTextSecondary" Color="{StaticResource ColorTextSecondary}" />
    <SolidColorBrush x:Key="BrushAccent" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="BrushAccentSecondary" Color="{StaticResource ColorAccentSecondary}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
</ResourceDictionary>
